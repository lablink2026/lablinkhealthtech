# Server & Database
PORT=3000
NODE_ENV=development
# Production/Docker connection string:
# DATABASE_URL=postgresql://lablink_admin:lablink_secret_password@localhost:5432/lablink_dev
# Leave empty for embedded zero-dependency PGlite engine:
DATABASE_URL=

# Authentication Secret (min 32 chars)
JWT_SECRET=super-secret-random-key-for-lablink-auth-32chars

# Payments (Paystack)
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=mock_webhook_secret

# Notifications (Termii for Nigeria SMS/WhatsApp)
TERMII_API_KEY=mock_termii_api_key
TERMII_SENDER_ID=Lablink

# Storage (S3 / Cloudflare R2)
STORAGE_PROVIDER=local # or s3
S3_ENDPOINT=
S3_BUCKET=lablink-results-vault
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI Provider (deterministic mock, or gemini, or claude)
AI_PROVIDER=mock # mock | gemini | claude
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Default Region / Timezone
APP_TIMEZONE=Africa/Lagos
APP_CURRENCY=NGN
